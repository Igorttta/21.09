<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleCalculatorMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Prosty kalkulator"
             BackgroundColor="Bisque">

    <StackLayout Orientation="Vertical" Spacing="20">
        <Label BackgroundColor="#E62121"
               FontAttributes="Bold"
               FontSize="20"
               Text="Podaj pierwszą liczbę:" />
        <Entry x:Name="firstNumberEntry" Text="15" />

        <Label BackgroundColor="#E62121"
               FontAttributes="Bold"
               FontSize="20"
               Text="Podaj drugą liczbę:" />
        <Entry x:Name="secondNumberEntry" />

        <Button Clicked="Button_Clicked" Text="Oblicz" />

        <Label x:Name="resultLabel" />
    </StackLayout>


</ContentPage>
